{
  "schemaVersion": 1,
  "id": "zangetsu",
  "version": "${version}",
  "name": "Zangetsu",
  "description": "Bleach's Zangetsu with a living eye: it comes to you in a dream the first time you sleep, grows with your bond, slices arrows and limbs, and at the top levels turns you into a Hollow.",
  "authors": ["Dobrelya22"],
  "contact": {
    "sources": "https://github.com/Dobrelya22/zangetsu-mod"
  },
  "license": "MIT",
  "icon": "assets/zangetsu/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.zangetsu.ZangetsuMod"],
    "client": ["com.zangetsu.client.ZangetsuClient"]
  },
  "mixins": [
    "zangetsu.mixins.json",
    {
      "config": "zangetsu.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
